{
  "description": "Garde NixOS : refuse d'activer une configuration, d'installer un paquet hors de la configuration et de détruire des générations.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/scripts/garde-nixos.sh"],
            "timeout": 15,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
